---
import SplitApp from '../components/SplitApp';
import '../styles/global.css';
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Divide gastos de grupo y descubre quién le paga a quién." />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <title>Entre Cuentas · Divide gastos sin dramas</title>
  </head>
  <body><SplitApp client:load /></body>
</html>
